# ==============================================================================
# Academic OS - Production Environment Configuration Template
# ==============================================================================

# Supabase Client & Backend Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Razorpay Payment Gateway & Webhook Verification
VITE_RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Biometric Turnstile Hardware HMAC Secret
BIOMETRIC_DEVICE_SECRET=biometric_hw_shared_secret_2026

# Sentry Telemetry & Observability
VITE_SENTRY_DSN=https://your-dsn-key@o0.ingest.sentry.io/0
SENTRY_DSN=https://your-dsn-key@o0.ingest.sentry.io/0

# Standalone Background Worker Settings (Docker / Railway / Fly.io)
WORKER_POLL_INTERVAL_MS=3000
PDF_STORAGE_BUCKET=institutional-documents
WORKER_SCHOOL_IDS=CAMPUS-01,CAMPUS-02,APEX-01

