-- ------------------------------------------------------------------------------
-- STAGE 7: REVERSAL MAKER-CHECKER & SELF-APPROVAL PREVENTION
-- ------------------------------------------------------------------------------
DO $$
DECLARE
  v_target_entry_id uuid := 'f0000000-0000-0000-0000-000000000001';
  v_req_id uuid;
  v_res jsonb;
  v_credit_note_count int;
  v_original_status text;
BEGIN
  RAISE NOTICE '====================================================================';
  RAISE NOTICE 'STAGE 7: VERIFYING REVERSAL MAKER-CHECKER WORKFLOW';
  RAISE NOTICE '====================================================================';

  -- 7.1 Step 1 (Maker): Alpha Accountant requests reversal
  PERFORM set_config('request.jwt.claim.sub', '00000000-0000-0000-0000-000000000001', true);
  PERFORM set_config('request.jwt.claims', '{"sub":"00000000-0000-0000-0000-000000000001", "role":"authenticated", "app_metadata":{"school_id":"a0000000-0000-0000-0000-000000000001", "school_code":"SCHOOL-ALPHA", "role":"ACC"}}', true);

  v_res := public.request_fee_reversal(v_target_entry_id, 15000.00, 'Duplicate transaction refund request');
