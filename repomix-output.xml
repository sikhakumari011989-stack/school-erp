            >
              Cancel
            </button>
            <button
              type="submit"
              className="px-5 py-2 rounded-xl bg-purple-600 hover:bg-purple-500 text-white font-bold transition-all shadow-md shadow-purple-600/30 cursor-pointer"
            >
              Save Question to Blueprint
            </button>
          </div>
        </form>
      )}
    </div>
  );
}
