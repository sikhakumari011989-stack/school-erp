import { supabase } from './src/supabaseClient.js';
import { buildStandardErpEmail, inferRoleFromCode, dashboardFor, normalizeRole } from './src/utils/credentials.js';

async function traceLogin(cleanInst, cleanPersonal, pass) {
  console.log(`\n=== TRACING LOGIN for ${cleanInst} / ${cleanPersonal} ===`);

  // Step 1: signInWithPassword
  const standardizedEmail = buildStandardErpEmail(cleanInst, cleanPersonal);
  const emailAlt = `${cleanInst.toLowerCase().replace(/[^a-z0-9]/g, "")}.${cleanPersonal.toLowerCase().replace(/[^a-z0-9]/g, "")}@gmail.com`;
  const candidates = [standardizedEmail, emailAlt];
  console.log('Candidates:', candidates);

  let authUser = null;
  for (const candidate of candidates) {
    const { data: authData, error: authErr } = await supabase.auth.signInWithPassword({
      email: candidate,
      password: pass,
    });
    if (!authErr && authData?.user) {
      authUser = authData.user;
      console.log('Auth succeeded for:', candidate, 'User ID:', authUser.id);
      break;
    } else {
      console.log('Auth failed for candidate:', candidate, authErr?.message);
    }
  }

  if (!authUser) {
    console.log('STEP 1 FAILED: No authUser found!');
    return;
  }

  // Step 2: Query profiles table
  console.log('\n--- Querying profiles table for user ID:', authUser.id, '---');
  const { data: profile, error: profileErr } = await supabase
    .from("profiles")
    .select("id, role, role_code, full_name, school_id, schools ( code, name )")
    .eq("id", authUser.id)
    .maybeSingle();

  console.log('Profile data:', profile);
  console.log('Profile error:', profileErr);

  // Step 3: AppContext loadProfile simulation
  console.log('\n--- Simulating AppContext.loadProfile ---');
  const appMeta = authUser.app_metadata || {};
  const userMeta = authUser.user_metadata || {};
  console.log('appMeta:', appMeta);
  console.log('userMeta:', userMeta);

  if (!profile && !appMeta.role && !appMeta.school_id && !userMeta.role && !userMeta.school_id) {
    console.log('CRITICAL: AppContext condition triggers: !profile && !appMeta.role && !appMeta.school_id && !userMeta.role && !userMeta.school_id is TRUE!');
    console.log('AppContext would call supabase.auth.signOut() and reject the session!');
  } else {
    console.log('AppContext would NOT reject session for missing profile/metadata.');
  }

  // Step 4: Role resolution & routing
  const rawRole = profile?.role || appMeta.role || userMeta.role || inferRoleFromCode(cleanPersonal);
  const resolvedRole = inferRoleFromCode(rawRole);
  const targetRoute = dashboardFor(resolvedRole);
  console.log('rawRole:', rawRole, 'resolvedRole:', resolvedRole, 'targetRoute:', targetRoute);
}

async function run() {
  await traceLogin('DEMOSCHOOL-01', 'HOD-01', 'password123');
}
run();
