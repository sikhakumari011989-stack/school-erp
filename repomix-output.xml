            >
              <option value="GST_EXEMPT">GST Exempt</option>
              <option value="TAXABLE_18">Taxable (18% GST)</option>
            </select>
          </div>

          <div>
            <label className="block text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-1">
