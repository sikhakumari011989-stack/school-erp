          >
            {msg.role === "user" ? (
              <div className="max-w-[85%] rounded-2xl p-3 leading-relaxed bg-gradient-to-r from-blue-600 via-indigo-600 to-cyan-600 text-white rounded-tr-none shadow-lg shadow-blue-600/20 font-medium">
                {msg.text}
