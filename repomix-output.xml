            is_partial: lr.is_partial,
            total_due: lr.total_due,
            remaining_balance: lr.remaining_balance,
          });
        }
      });

      setLedger(combined);

      // Calculate real-time financial stats including verification queue
      let revenue = 0;
      let pending = 0;
      let paidCount = 0;
      let pendingVerificationCount = 0;

      combined.forEach((item) => {
        const val = Number(item.amount) || 0;
        const st = (item.status || "").toLowerCase();
        if (st === "paid") {
          revenue += val;
          paidCount += 1;
        } else if (st === "pending_verification") {
          pendingVerificationCount += 1;
          pending += val;
        } else {
          pending += val;
        }
      });

      setStats({
        totalRevenue: revenue,
        pendingDues: pending,
        totalPaidCount: paidCount,
        pendingVerificationCount,
      });

      // 1. Monthly Collection Trend
      const monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
      const monthsMap = {};
      for (let i = 5; i >= 0; i--) {
        const d = new Date();
        d.setMonth(d.getMonth() - i);
        const mKey = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}`;
        monthsMap[mKey] = {
          month: `${monthNames[d.getMonth()]} ${String(d.getFullYear()).slice(-2)}`,
          collected: 0,
          due: 0,
        };
      }

      localRecords.forEach((item) => {
        const dStr = item.date || item.created_at || "";
        const mPrefix = dStr.slice(0, 7);
        const amt = Number(item.amount) || 0;
        const isPaid = (item.status || "").toLowerCase() === "paid";
        if (monthsMap[mPrefix]) {
          if (isPaid) monthsMap[mPrefix].collected += amt;
          else monthsMap[mPrefix].due += amt;
        }
      });
      setMonthlyTrend(Object.values(monthsMap));

      // 2. Fee Category / Mode Distribution
      const modeMap = {};
      localRecords.forEach((item) => {
        const rawMode = item.payment_mode || "Cash / Cheque";
        let cleanMode = "Cash / Cheque";
        if (rawMode.toLowerCase().includes("upi")) cleanMode = "School UPI QR";
        else if (rawMode.toLowerCase().includes("razorpay") || rawMode.toLowerCase().includes("online")) cleanMode = "Online Gateway";
        else if (rawMode.toLowerCase().includes("bank") || rawMode.toLowerCase().includes("transfer") || rawMode.toLowerCase().includes("neft")) cleanMode = "Bank Transfer";
        modeMap[cleanMode] = (modeMap[cleanMode] || 0) + (Number(item.amount) || 0);
      });
      const modeColors = ["#10B981", "#06B6D4", "#8B5CF6", "#F59E0B"];
      const catList = Object.entries(modeMap).map(([k, v], idx) => ({
        name: k,
        value: v,
        color: modeColors[idx % modeColors.length],
      }));
      setFeeCategoryData(catList);

      // 3. Payment Status Breakdown
      const stCount = { Paid: 0, Pending: 0, Verification: 0 };
      localRecords.forEach((item) => {
        const st = (item.status || "").toLowerCase();
        if (st === "paid") stCount.Paid += 1;
        else if (st === "pending_verification") stCount.Verification += 1;
        else stCount.Pending += 1;
      });
      setPaymentStatusData([
        { status: "Paid", count: stCount.Paid, fill: "#10B981" },
        { status: "Pending", count: stCount.Pending, fill: "#F59E0B" },
        { status: "Awaiting UPI", count: stCount.Verification, fill: "#06B6D4" },
      ]);
    } catch (err) {
      console.error("Error fetching financial ledger:", err);
      setLedger(localRecords);
      let revenue = 0;
      let pending = 0;
      let paidCount = 0;
      let pendingVerificationCount = 0;
      localRecords.forEach((item) => {
        const val = Number(item.amount) || 0;
        const st = (item.status || "").toLowerCase();
        if (st === "paid") {
          revenue += val;
          paidCount += 1;
        } else if (st === "pending_verification") {
          pendingVerificationCount += 1;
          pending += val;
        } else {
          pending += val;
        }
      });
      setStats({
        totalRevenue: revenue,
        pendingDues: pending,
        totalPaidCount: paidCount,
        pendingVerificationCount,
      });

      // 1. Monthly Collection Trend
      const monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
      const monthsMap = {};
      for (let i = 5; i >= 0; i--) {
        const d = new Date();
        d.setMonth(d.getMonth() - i);
        const mKey = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}`;
        monthsMap[mKey] = {
          month: `${monthNames[d.getMonth()]} ${String(d.getFullYear()).slice(-2)}`,
          collected: 0,
          due: 0,
        };
      }

      localRecords.forEach((item) => {
        const dStr = item.date || item.created_at || "";
        const mPrefix = dStr.slice(0, 7);
        const amt = Number(item.amount) || 0;
        const isPaid = (item.status || "").toLowerCase() === "paid";
        if (monthsMap[mPrefix]) {
          if (isPaid) monthsMap[mPrefix].collected += amt;
          else monthsMap[mPrefix].due += amt;
        }
      });
      setMonthlyTrend(Object.values(monthsMap));

      // 2. Fee Category / Mode Distribution
      const modeMap = {};
      localRecords.forEach((item) => {
        const rawMode = item.payment_mode || "Cash / Cheque";
        let cleanMode = "Cash / Cheque";
        if (rawMode.toLowerCase().includes("upi")) cleanMode = "School UPI QR";
        else if (rawMode.toLowerCase().includes("razorpay") || rawMode.toLowerCase().includes("online")) cleanMode = "Online Gateway";
        else if (rawMode.toLowerCase().includes("bank") || rawMode.toLowerCase().includes("transfer") || rawMode.toLowerCase().includes("neft")) cleanMode = "Bank Transfer";
        modeMap[cleanMode] = (modeMap[cleanMode] || 0) + (Number(item.amount) || 0);
      });
      const modeColors = ["#10B981", "#06B6D4", "#8B5CF6", "#F59E0B"];
      const catList = Object.entries(modeMap).map(([k, v], idx) => ({
        name: k,
        value: v,
        color: modeColors[idx % modeColors.length],
      }));
      setFeeCategoryData(catList);

      // 3. Payment Status Breakdown
      const stCount = { Paid: 0, Pending: 0, Verification: 0 };
      localRecords.forEach((item) => {
        const st = (item.status || "").toLowerCase();
        if (st === "paid") stCount.Paid += 1;
        else if (st === "pending_verification") stCount.Verification += 1;
        else stCount.Pending += 1;
      });
      setPaymentStatusData([
        { status: "Paid", count: stCount.Paid, fill: "#10B981" },
        { status: "Pending", count: stCount.Pending, fill: "#F59E0B" },
        { status: "Awaiting UPI", count: stCount.Verification, fill: "#06B6D4" },
      ]);
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    fetchLedger();
    const handleUpdate = () => fetchLedger();
    window.addEventListener("erp-fee-ledger-updated", handleUpdate);
    return () => window.removeEventListener("erp-fee-ledger-updated", handleUpdate);
  }, [schoolId]);

  const handleAddTransaction = async (e) => {
    e.preventDefault();
    if (!formData.student_name || !formData.amount) {
      showToast("Please provide student name and amount", "error");
      return;
    }

    setSubmitting(true);
    const newTxn = {
      id: `TXN-${Date.now()}`,
      school_id: schoolId,
      student_name: formData.student_name.trim(),
      class_name: formData.class_name.trim() || "Class 10-A",
      amount: Number(formData.amount),
      status: formData.status,
      payment_mode: formData.payment_mode,
      date: new Date().toISOString().split("T")[0],
    };

    try {
      if (supabase) {
        const { error: insertErr } = await supabase.from("fee_ledger").insert([newTxn]);
        if (insertErr) {
          console.error("Supabase fee_ledger insert error:", insertErr);
          throw insertErr;
        }
      }

      try {
        const tenantKey = `erp_fee_ledger_${schoolId}`;
        const savedTenantRaw = localStorage.getItem(tenantKey);
        const tenantList = savedTenantRaw ? JSON.parse(savedTenantRaw) : [];
        tenantList.unshift(newTxn);
        localStorage.setItem(tenantKey, JSON.stringify(tenantList));

