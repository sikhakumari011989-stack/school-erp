import React, { useState, useEffect, useContext } from "react";
import { useNavigate } from "react-router-dom";
import { AppContext } from "../context/AppContext";
import { useToast } from "../context/ToastContext";
import { supabase } from "../supabaseClient";
import { notifyFeePaymentConfirmed } from "../utils/notifications";
import { logSecurityAction, AUDIT_ACTIONS } from "../utils/auditLogger";
import { DEFAULT_DEMO_QR_SVG } from "../Components/SchoolUpiQrConfig";
import {
  QrCode,
  Copy,
  Check,
  CheckCircle2,
  ExternalLink,
  ShieldCheck,
  Sparkles,
  Upload,
  Receipt,
  Smartphone,
  Info,
} from "lucide-react";

export default function StudentRazorpayCheckout() {
  const { user } = useContext(AppContext);
  const { showToast } = useToast();
  const navigate = useNavigate();

  const [loading, setLoading] = useState(false);
  const [copiedUpi, setCopiedUpi] = useState(false);
  const [utrNumber, setUtrNumber] = useState("");
  const [screenshotName, setScreenshotName] = useState("");
  const [screenshotData, setScreenshotData] = useState(null);
  const [paymentSplitType, setPaymentSplitType] = useState("full"); // "full" | "partial"
  const [customInstallment, setCustomInstallment] = useState("");

  const activeSchoolCode = (
    user?.institution_code ||
    user?.school_id ||
    "CAMPUS-01"
  )
    .trim()
    .toUpperCase();

  const [availableFees, setAvailableFees] = useState([]);
  const [selectedFee, setSelectedFee] = useState(null);
  const [loadingFees, setLoadingFees] = useState(true);

  // Dynamic School UPI Data
  const [schoolQr, setSchoolQr] = useState(DEFAULT_DEMO_QR_SVG);
  const [schoolUpiMeta, setSchoolUpiMeta] = useState({
    upiId: `${activeSchoolCode.toLowerCase().replace(/[^a-z0-9]/g, "")}.edu@okaxis`,
    merchantName: user?.institution_name || user?.school_name || "Institutional Campus",
    instructions:
      "Scan via Google Pay, PhonePe, Paytm, or BHIM. Enter student name in remarks, then input 12-digit UTR below.",
  });

  const loadFeesAndConfig = async () => {
    try {
      const savedQr = localStorage.getItem(`erp_school_qr_${activeSchoolCode}`);
      if (savedQr) setSchoolQr(savedQr);

      const savedMeta = localStorage.getItem(`erp_school_upi_${activeSchoolCode}`);
      if (savedMeta) {
        setSchoolUpiMeta((prev) => ({ ...prev, ...JSON.parse(savedMeta) }));
      }
    } catch (e) {
      console.warn("Error loading student checkout UPI config:", e);
    }

    // Dynamic fee structures configured by school HOD/Principal
    setLoadingFees(true);
    let loaded = [];
    try {
      const savedFees = localStorage.getItem(`erp_fee_structure_${activeSchoolCode}`);
      if (savedFees) {
        const parsed = JSON.parse(savedFees);
        if (Array.isArray(parsed) && parsed.length > 0) loaded = parsed;
      }
    } catch (e) {}

    try {
      if (supabase) {
        const { data, error } = await supabase
          .from("fee_structures")
          .select("*")
          .eq("school_id", activeSchoolCode);

        if (!error && data && data.length > 0) {
          const map = new Map();
          data.forEach((d) => map.set(d.id, {
            id: d.id,
            title: d.title || d.component_name,
            term: d.term || d.category || "Term Fee",
            amount: Number(d.amount) || 0,
            description: d.description || "",
          }));
          loaded.forEach((l) => {
            if (!map.has(l.id)) map.set(l.id, l);
          });
          loaded = Array.from(map.values());
        }
      }
    } catch (err) {}

    setAvailableFees(loaded);
    setSelectedFee((prev) => {
      if (prev && loaded.some((f) => f.title === prev.title)) return prev;
      return loaded.length > 0 ? loaded[0] : null;
    });
    setLoadingFees(false);
  };

  useEffect(() => {
    loadFeesAndConfig();
    const handleUpdate = () => loadFeesAndConfig();
    window.addEventListener("erp-fee-structure-updated", handleUpdate);
    return () => window.removeEventListener("erp-fee-structure-updated", handleUpdate);
  }, [activeSchoolCode]);

  const handleCopyUpi = () => {
    navigator.clipboard.writeText(schoolUpiMeta.upiId);
    setCopiedUpi(true);
    showToast("School UPI ID copied! Paste into your UPI app.", "info");
    setTimeout(() => setCopiedUpi(false), 2000);
  };

  const handleScreenshotChange = (e) => {
    const file = e.target.files?.[0];
    if (file) {
      setScreenshotName(file.name);
      const reader = new FileReader();
      reader.onload = (event) => setScreenshotData(event.target?.result);
      reader.readAsDataURL(file);
      showToast(`Attached receipt screenshot: ${file.name}`, "info");
    }
  };

  /**
   * Unified payment settlement handler
   */
  const processUpiSettlement = async (enteredUtr, paymentModeOverride) => {
    if (!selectedFee) {
      showToast("No active fee structure selected. Please select a published fee head to settle.", "error");
      return;
    }

    const cleanUtr = String(enteredUtr || "").trim();

    if (!cleanUtr || cleanUtr.length < 8) {
      showToast("Please enter a valid 12-digit UPI Transaction Reference (UTR) number.", "error");
      return;
    }

    // 1. Guard against duplicate UTR submission (Roll Number & UTR collision prevention)
    let isDuplicate = false;
    try {
      const tenantKey = `erp_fee_ledger_${activeSchoolCode}`;
      const savedTenant = localStorage.getItem(tenantKey);
      if (savedTenant) {
        const list = JSON.parse(savedTenant);
        if (list.some((r) => String(r.utr || r.razorpay_payment_id || "").trim().toUpperCase() === cleanUtr.toUpperCase())) {
          isDuplicate = true;
        }
      }
      if (!isDuplicate) {
        const savedGlobal = localStorage.getItem("erp_fee_ledger");
        if (savedGlobal) {
          const list = JSON.parse(savedGlobal);
          if (list.some((r) => String(r.utr || r.razorpay_payment_id || "").trim().toUpperCase() === cleanUtr.toUpperCase() && String(r.school_id || "").toUpperCase() === activeSchoolCode)) {
            isDuplicate = true;
          }
        }
      }
    } catch (e) {}

    if (isDuplicate) {
      showToast(`Transaction Reference (UTR) "${cleanUtr}" has already been registered. Duplicate submissions are not permitted.`, "error");
      return;
    }

    // 2. Partial fee payment calculation
    const isPartial = paymentSplitType === "partial";
    const numInstallment = Number(customInstallment);
    if (isPartial && (!numInstallment || numInstallment <= 0 || numInstallment > Number(selectedFee.amount))) {
      showToast(`Please enter a valid installment amount between ₹1 and ₹${Number(selectedFee.amount).toLocaleString()}.`, "error");
      return;
    }

    const amountToSettle = isPartial ? numInstallment : Number(selectedFee.amount);
    const remainingBalance = Math.max(0, Number(selectedFee.amount) - amountToSettle);

    setLoading(true);

    const today = new Date().toISOString().split("T")[0];
    const studentName = user?.name || user?.full_name || "Enrolled Student";
    const rawPhone = user?.parent_phone || user?.phone || "9876543210";
    const studentPhone = rawPhone.replace(/[^0-9]/g, "").slice(-10) || "9876543210";
    const schoolId = user?.school_id || activeSchoolCode;
    const institutionName = user?.institution_name || schoolUpiMeta.merchantName || "Institutional Campus";
    const invoiceNo = isPartial ? `INV-${Date.now().toString().slice(-6)}-PARTIAL` : `INV-${Date.now().toString().slice(-6)}`;
    const paymentMode = paymentModeOverride || (isPartial ? `School UPI QR (UTR: ${cleanUtr}) [PARTIAL]` : `School UPI QR (UTR: ${cleanUtr})`);

    try {
      // 1. Supabase fee_ledger insertion with pending_verification and PARTIAL tag
      try {
        const studentRoll = String(user?.personal_code || user?.roll_number || user?.id || "").trim().toUpperCase();
        const studentEmail = String(user?.email || "").trim().toLowerCase();

        const { error: ledgerError } = await supabase.from("fee_ledger").insert([
          {
            school_id: schoolId,
            student_name: studentName,
            roll_number: studentRoll,
            student_id: user?.id || studentRoll,
            student_email: studentEmail,
            class_name: user?.class_name || "Class 10 ICSE",
            amount: amountToSettle,
            status: "pending_verification",
            payment_mode: paymentMode,
            razorpay_payment_id: cleanUtr,
            date: today,
            term: isPartial ? `${selectedFee.title} [PARTIAL]` : selectedFee.title,
          },
        ]);
        if (ledgerError) console.warn("fee_ledger sync notice:", ledgerError.message);
      } catch (lErr) {
        console.warn("Supabase ledger insert notice:", lErr);
      }

      // 2. Supabase fees table insertion
      try {
        await supabase.from("fees").insert([
          {
            school_id: schoolId,
            student_id: user?.id && user.id.length === 36 ? user.id : null,
            amount: amountToSettle,
            status: "pending_verification",
            date: today,
          },
        ]);
      } catch (fErr) {
        console.warn("fees table sync notice:", fErr);
      }

      // 3. LocalStorage persistence (erp_fee_ledger) with status: pending_verification and PARTIAL tag
      try {
        const studentRoll = String(user?.personal_code || user?.roll_number || user?.id || "").trim().toUpperCase();
        const studentEmail = String(user?.email || "").trim().toLowerCase();

        const existingRaw = localStorage.getItem("erp_fee_ledger");
        const existingList = existingRaw ? JSON.parse(existingRaw) : [];
        const newRecord = {
          id: `TXN-${Date.now()}`,
          school_id: schoolId,
          student_name: studentName,
          roll_number: studentRoll,
          student_id: user?.id || studentRoll,
          student_email: studentEmail,
          class_name: user?.class_name || "Class 10 ICSE",
          amount: amountToSettle,
          total_due: Number(selectedFee.amount),
          is_partial: isPartial,
          remaining_balance: remainingBalance,
          receipt_tag: isPartial ? "PARTIAL" : "FULL",
          receipt_type: isPartial ? "PARTIAL" : "FULL",
          status: "pending_verification",
          payment_mode: paymentMode,
          razorpay_payment_id: cleanUtr,
          utr: cleanUtr,
          date: today,
          invoice_no: invoiceNo,
          title: isPartial ? `${selectedFee.title} (PARTIAL)` : selectedFee.title,
          term: isPartial ? `${selectedFee.title} (PARTIAL)` : selectedFee.title,
          screenshot: screenshotName || null,
          screenshot_data: screenshotData || null,
          submitted_at: new Date().toISOString(),
        };
        existingList.unshift(newRecord);
        localStorage.setItem("erp_fee_ledger", JSON.stringify(existingList));

        // Also persist to tenant-specific ledger and broadcast live update event
        if (schoolId) {
          const tenantRaw = localStorage.getItem(`erp_fee_ledger_${schoolId}`);
          const tenantList = tenantRaw ? JSON.parse(tenantRaw) : [];
          tenantList.unshift(newRecord);
          localStorage.setItem(`erp_fee_ledger_${schoolId}`, JSON.stringify(tenantList));
        }
        window.dispatchEvent(new Event("erp-fee-ledger-updated"));
      } catch (storageErr) {
        console.warn("LocalStorage ledger sync notice:", storageErr);
      }

      // 4. Role-based security audit logging
      logSecurityAction({
        action: AUDIT_ACTIONS.FEE_COLLECTION,
        entityType: "UPI_SETTLEMENT_SUBMISSION",
        entityId: invoiceNo,
        details: `UPI Fee submission of ₹${amountToSettle} (UTR: ${cleanUtr}${isPartial ? `, Partial of ₹${selectedFee.amount}` : ""}) pending verification by Accountant.`,
        user,
        schoolId,
      });

      showToast(
        `Payment UTR ${cleanUtr} submitted! Status: PENDING VERIFICATION by School Accountant.`,
        "success"
      );

      setTimeout(() => {
        setLoading(false);
        navigate("/student/fees");
      }, 1200);
    } catch (err) {
      console.error("Payment settlement error:", err);
      setLoading(false);
      showToast("Payment captured locally. Syncing ledger...", "info");
      navigate("/student/fees");
    }
  };

  /**
   * Production-Grade Razorpay Standard Checkout Launch & Verification
   */
  const handleLaunchRazorpayOnlinePayment = async () => {
    if (!selectedFee) {
      showToast("Please select a published fee head above to settle.", "error");
      return;
    }

    const isPartial = paymentSplitType === "partial";
    const numInstallment = Number(customInstallment);
    if (isPartial && (!numInstallment || numInstallment <= 0 || numInstallment > Number(selectedFee.amount))) {
      showToast(`Please enter a valid installment amount up to ₹${Number(selectedFee.amount).toLocaleString()}.`, "error");
      return;
    }

    const amountToSettle = isPartial ? numInstallment : Number(selectedFee.amount);
    setLoading(true);

    try {
      // 1. Initiate Razorpay Order from serverless gateway
      const resp = await fetch("/api/razorpay/create-order", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          amount: amountToSettle,
          schoolId: activeSchoolCode,
          studentId: user?.personal_code || user?.roll_number || user?.id || "STU-001",
          studentName: user?.name || user?.full_name || "Enrolled Student",
          studentEmail: user?.email || "",
          feeTitle: selectedFee.title,
          isPartial,
        }),
      });

      const orderData = await resp.json().catch(() => ({}));
      if (!resp.ok || !orderData.success || !orderData.order) {
        throw new Error(orderData.error || "Failed to initiate online payment session with gateway.");
      }

      // 2. Load Razorpay Checkout SDK dynamically if not yet on window
      if (!window.Razorpay) {
        await new Promise((resolve, reject) => {
          const script = document.createElement("script");
          script.src = "https://checkout.razorpay.com/v1/checkout.js";
          script.async = true;
          script.onload = resolve;
          script.onerror = () => reject(new Error("Failed to load Razorpay payment SDK. Please verify internet connection."));
          document.body.appendChild(script);
        });
      }

      const options = {
        key: orderData.order.key_id,
        amount: orderData.order.amount,
        currency: orderData.order.currency,
        name: user?.institution_name || schoolUpiMeta.merchantName || "Academic OS",
        description: `${selectedFee.title} Institutional Fee Clearance`,
        order_id: orderData.order.id,
        prefill: {
          name: user?.name || user?.full_name || "",
          email: user?.email || "",
          contact: user?.phone || "",
        },
        theme: {
          color: "#4F46E5",
        },
        handler: async function (paymentResponse) {
          // 3. Cryptographically verify signature on serverless backend
          try {
            showToast("Verifying payment signature with treasury server...", "info");
            const verifyResp = await fetch("/api/razorpay/verify-payment", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                razorpay_order_id: paymentResponse.razorpay_order_id,
                razorpay_payment_id: paymentResponse.razorpay_payment_id,
                razorpay_signature: paymentResponse.razorpay_signature,
                schoolId: activeSchoolCode,
                studentId: user?.personal_code || user?.roll_number || user?.id,
                studentName: user?.name || user?.full_name,
                studentEmail: user?.email,
                className: user?.class_name,
                amount: amountToSettle,
                feeTitle: selectedFee.title,
                isPartial,
              }),
            });

            const verifyData = await verifyResp.json().catch(() => ({}));
            if (!verifyResp.ok || !verifyData.verified) {
              showToast("Payment verification failed: " + (verifyData.error || "Invalid signature"), "error");
              setLoading(false);
              return;
            }

            showToast(`Payment Verified! Official Tax Invoice: ${verifyData.invoice_no}`, "success");

            // Update local storage for immediate UI reconciliation
            const newRecord = {
              id: `TXN-${paymentResponse.razorpay_payment_id}`,
              school_id: activeSchoolCode,
              student_name: user?.name || user?.full_name,
              roll_number: user?.personal_code || user?.roll_number,
              amount: amountToSettle,
              status: "paid",
              payment_mode: "Razorpay Online Gateway",
              razorpay_payment_id: paymentResponse.razorpay_payment_id,
              date: new Date().toISOString().split("T")[0],
              invoice_no: verifyData.invoice_no,
              term: selectedFee.title,
            };

            const tenantKey = `erp_fee_ledger_${activeSchoolCode}`;
            const existing = JSON.parse(localStorage.getItem(tenantKey) || "[]");
            localStorage.setItem(tenantKey, JSON.stringify([newRecord, ...existing]));
            window.dispatchEvent(new Event("erp-fee-ledger-updated"));

            setTimeout(() => {
              navigate("/student/fees");
            }, 1000);
          } catch (verErr) {
            console.error("Verification error:", verErr);
            showToast("Server payment verification failed. Please contact school accountant.", "error");
            setLoading(false);
          }
        },
        modal: {
          ondismiss: function () {
            setLoading(false);
            showToast("Payment session cancelled by student.", "info");
          },
        },
      };

      const rzp = new window.Razorpay(options);
      rzp.on("payment.failed", function (failResponse) {
        console.error("Payment failed:", failResponse.error);
        showToast(`Payment failed: ${failResponse.error.description}`, "error");
        setLoading(false);
      });
      rzp.open();
    } catch (err) {
      console.error("Online payment initiation error:", err);
      showToast(err.message, "error");
      setLoading(false);
    }
  };

  // UPI Deep Link for mobile devices
  const upiDeepLink = selectedFee
    ? `upi://pay?pa=${encodeURIComponent(schoolUpiMeta.upiId)}&pn=${encodeURIComponent(
        schoolUpiMeta.merchantName
      )}&am=${selectedFee.amount}&cu=INR&tn=${encodeURIComponent(selectedFee.title)}`
    : "#";

  return (
    <div className="relative text-slate-200 min-h-full pb-10 font-sans">
      <div className="fixed top-0 left-10 w-96 h-96 bg-blue-600/10 rounded-full blur-[120px] pointer-events-none"></div>

      <div className="relative z-10 max-w-4xl mx-auto space-y-8">
        {/* HEADER */}
        <div className="text-center space-y-2">
          <div className="inline-flex items-center gap-1.5 bg-emerald-500/20 text-emerald-400 text-xs font-black uppercase px-3 py-1 rounded-full border border-emerald-500/30">
            <ShieldCheck className="w-4 h-4" />
            Official Institutional Fee Settlement Node
          </div>
          <h1 className="text-3xl md:text-4xl font-extrabold text-white flex items-center justify-center gap-3">
            <Smartphone className="w-8 h-8 text-blue-400" />
            Official School UPI QR & Instant Fee Settlement
          </h1>
          <p className="text-slate-400 text-sm max-w-xl mx-auto">
            Scan using any UPI app (PhonePe, GPay, Paytm) for direct, zero-surcharge bank settlement into{" "}
            <span className="text-white font-semibold">{schoolUpiMeta.merchantName}</span>.
          </p>
        </div>

        <div className="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          {/* LEFT COLUMN: QR CODE & PAYMENT RAILS (5 COLS) */}
          <div className="lg:col-span-5 bg-[#1E293B]/80 backdrop-blur-xl border border-slate-700/80 rounded-3xl p-6 shadow-2xl text-center space-y-5">
            <div className="inline-flex items-center gap-1.5 bg-blue-500/20 text-blue-400 text-xs font-bold px-3 py-1 rounded-full border border-blue-500/30">
              <CheckCircle2 className="w-3.5 h-3.5 text-emerald-400" />
              Verified Institutional Merchant
            </div>

            <div>
              <h3 className="text-lg font-black text-white">{schoolUpiMeta.merchantName}</h3>
              <p className="text-xs text-slate-400 font-mono mt-0.5">{schoolUpiMeta.upiId}</p>
            </div>

            {/* QR CODE CONTAINER */}
            <div className="bg-white p-4 rounded-3xl shadow-2xl inline-block border-4 border-slate-800 relative group">
              <img
                src={schoolQr}
                alt="School Official UPI QR"
                className="w-56 h-56 object-contain mx-auto"
              />
              <div className="text-[10px] text-slate-700 font-bold uppercase tracking-widest mt-1">
                Scan with any UPI App
              </div>
            </div>

            {/* ACCEPTED APPS */}
            <div className="flex items-center justify-center gap-1.5 flex-wrap">
              <span className="text-xs font-bold text-slate-300 bg-slate-900 border border-slate-700 px-2.5 py-1 rounded-lg">PhonePe</span>
              <span className="text-xs font-bold text-slate-300 bg-slate-900 border border-slate-700 px-2.5 py-1 rounded-lg">Google Pay</span>
              <span className="text-xs font-bold text-slate-300 bg-slate-900 border border-slate-700 px-2.5 py-1 rounded-lg">Paytm</span>
              <span className="text-xs font-bold text-slate-300 bg-slate-900 border border-slate-700 px-2.5 py-1 rounded-lg">BHIM</span>
            </div>

            {/* ACTION BUTTONS (COPY & DEEP-LINK) */}
            <div className="grid grid-cols-2 gap-3 pt-1">
              <button
                type="button"
                onClick={handleCopyUpi}
                className="bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-600 font-bold py-2.5 px-3 rounded-xl transition-all text-xs flex items-center justify-center gap-1.5 cursor-pointer"
              >
                {copiedUpi ? (
                  <>
                    <Check className="w-4 h-4 text-emerald-400" />
                    <span>Copied!</span>
                  </>
                ) : (
                  <>
                    <Copy className="w-4 h-4 text-blue-400" />
                    <span>Copy UPI ID</span>
                  </>
                )}
              </button>

              <a
                href={upiDeepLink}
                className="bg-blue-600/30 hover:bg-blue-600/40 text-blue-300 border border-blue-500/50 font-bold py-2.5 px-3 rounded-xl transition-all text-xs flex items-center justify-center gap-1.5"
              >
                <ExternalLink className="w-4 h-4" />
                <span>Open UPI App</span>
              </a>
            </div>

            {/* INSTRUCTIONS */}
            <div className="bg-slate-900/80 p-3.5 rounded-2xl border border-slate-800 text-left">
              <p className="text-xs text-slate-400 leading-relaxed flex items-start gap-2">
                <Info className="w-4 h-4 text-amber-400 shrink-0 mt-0.5" />
                <span>{schoolUpiMeta.instructions}</span>
              </p>
            </div>
          </div>

          {/* RIGHT COLUMN: FEE SELECTION & UTR SUBMISSION (7 COLS) */}
          <div className="lg:col-span-7 bg-[#1E293B]/80 backdrop-blur-xl border border-slate-700/80 rounded-3xl p-6 md:p-8 shadow-2xl space-y-6">
            {/* FEE SELECTOR */}
            <div>
              <label className="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-2">
                1. Select Fee Component to Settle
              </label>
              {loadingFees ? (
                <div className="p-8 text-center text-slate-400 text-xs">Loading published fee structures...</div>
              ) : availableFees.length === 0 ? (
                <div className="p-8 text-center bg-slate-900/60 rounded-2xl border border-slate-800 text-slate-400 space-y-3">
                  <div className="text-4xl opacity-60">📑</div>
                  <h4 className="text-base font-bold text-white">No active fee structures published by school administration yet.</h4>
                  <p className="text-xs text-slate-400 max-w-sm mx-auto">
                    Your school administration has not configured any fee heads for online settlement yet. Please contact your HOD or Accounts department.
                  </p>
                </div>
              ) : (
                <div className="space-y-2.5">
                  {availableFees.map((fee, idx) => (
                    <div
                      key={fee.id || idx}
                      onClick={() => setSelectedFee(fee)}
                      className={`p-4 rounded-2xl border cursor-pointer transition-all flex justify-between items-center ${
                        selectedFee?.title === fee.title
                          ? "bg-blue-600/20 border-blue-500 shadow-lg shadow-blue-500/10"
                          : "bg-slate-900/60 border-slate-800 hover:border-slate-700"
                      }`}
                    >
                      <div>
                        <p className="font-bold text-white text-sm">{fee.title}</p>
                        <span className="text-[11px] text-blue-400 font-semibold">{fee.term}</span>
                      </div>
                      <span className="font-black text-emerald-400 text-base">
                        ₹{Number(fee.amount || 0).toLocaleString()}
                      </span>
                    </div>
                  ))}
                </div>
              )}
            </div>

            {/* PAYABLE SUMMARY */}
            {selectedFee && (
              <div className="bg-slate-900/70 p-4 rounded-2xl border border-slate-800 space-y-2">
                <div className="flex justify-between items-center text-xs">
                  <span className="text-slate-400 font-bold uppercase">Enrolled Student</span>
                  <span className="text-white font-bold">
                    {user?.name || user?.full_name || "Enrolled Student"} ({activeSchoolCode})
                  </span>
                </div>
                <div className="flex justify-between items-center text-xs">
                  <span className="text-slate-400 font-bold uppercase">Settlement Component</span>
                  <span className="text-blue-400 font-bold">{selectedFee.title}</span>
                </div>
                <div className="flex justify-between items-center pt-2 border-t border-slate-800">
                  <span className="text-slate-200 font-bold text-sm">Total Fee Head Value</span>
                  <span className="text-2xl font-black text-emerald-400">
                    ₹{Number(selectedFee.amount || 0).toLocaleString()}
                  </span>
                </div>
              </div>
            )}

            {/* PARTIAL FEE PAYMENT SPLITTER */}
            {selectedFee && (
              <div className="bg-slate-900/60 p-4 rounded-2xl border border-slate-800 space-y-3">
                <div className="flex items-center justify-between">
                  <label className="text-xs font-bold text-slate-300 uppercase tracking-wider">
                    Settlement Structure & Splitter
                  </label>
                  <span className="text-[10px] font-bold text-blue-400 uppercase tracking-widest bg-blue-500/10 px-2 py-0.5 rounded border border-blue-500/30">
                    Flexible Installment
                  </span>
                </div>
                <div className="grid grid-cols-2 gap-3">
                  <button
                    type="button"
                    onClick={() => {
                      setPaymentSplitType("full");
                      setCustomInstallment("");
                    }}
                    className={`p-3 rounded-xl border text-left transition-all cursor-pointer ${
                      paymentSplitType === "full"
                        ? "bg-emerald-500/20 border-emerald-500/60 text-white shadow-md shadow-emerald-500/10"
                        : "bg-slate-800/60 border-slate-700 text-slate-400 hover:text-slate-200"
                    }`}
                  >
                    <p className="text-xs font-extrabold flex items-center justify-between">
                      <span>Full Clearance</span>
                      {paymentSplitType === "full" && <Check className="w-3.5 h-3.5 text-emerald-400" />}
                    </p>
                    <p className="text-emerald-400 font-black text-sm mt-1">₹{Number(selectedFee.amount).toLocaleString()}</p>
                    <p className="text-[10px] text-slate-400">100% full dues settlement</p>
                  </button>

                  <button
                    type="button"
                    onClick={() => {
                      setPaymentSplitType("partial");
                      if (!customInstallment) {
                        setCustomInstallment(String(Math.round(Number(selectedFee.amount) / 2)));
                      }
                    }}
                    className={`p-3 rounded-xl border text-left transition-all cursor-pointer ${
                      paymentSplitType === "partial"
                        ? "bg-blue-500/20 border-blue-500/60 text-white shadow-md shadow-blue-500/10"
                        : "bg-slate-800/60 border-slate-700 text-slate-400 hover:text-slate-200"
                    }`}
                  >
                    <p className="text-xs font-extrabold flex items-center justify-between">
                      <span>Partial Installment</span>
                      {paymentSplitType === "partial" && <Check className="w-3.5 h-3.5 text-blue-400" />}
                    </p>
                    <p className="text-blue-400 font-black text-sm mt-1">Custom Split</p>
                    <p className="text-[10px] text-slate-400">Pay customized balance</p>
                  </button>
                </div>

                {paymentSplitType === "partial" && (
                  <div className="pt-2 border-t border-slate-800/80 space-y-2">
                    <label className="block text-xs font-semibold text-slate-300">
                      Enter Installment Amount (₹) *
                    </label>
                    <div className="relative">
                      <span className="absolute left-3.5 top-2.5 text-slate-400 font-bold">₹</span>
                      <input
                        type="number"
                        min="1"
                        max={selectedFee.amount}
                        value={customInstallment}
                        onChange={(e) => setCustomInstallment(e.target.value)}
                        placeholder={`e.g. ${Math.round(Number(selectedFee.amount) / 2)}`}
                        className="w-full bg-slate-900 border border-blue-500/50 rounded-xl pl-8 pr-4 py-2.5 text-white font-mono font-bold text-sm focus:outline-none focus:border-blue-400"
                      />
                    </div>
                    {Number(customInstallment) > 0 && (
                      <div className="flex justify-between items-center text-xs text-slate-400 pt-1">
                        <span>Paying now: <strong className="text-emerald-400 font-mono font-bold">₹{Number(customInstallment).toLocaleString()}</strong></span>
                        <span>Remaining balance: <strong className="text-amber-400 font-mono font-bold">₹{Math.max(0, Number(selectedFee.amount) - Number(customInstallment)).toLocaleString()}</strong></span>
                      </div>
                    )}
                  </div>
                )}
              </div>
            )}

            {/* UTR ENTRY FORM */}
            <form
              onSubmit={(e) => {
                e.preventDefault();
                processUpiSettlement(utrNumber);
              }}
              className="space-y-4 pt-2 border-t border-slate-700/80"
            >
              <div>
                <label className="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-2">
                  2. Enter 12-Digit Bank UTR / UPI Reference Number *
                </label>
                <div className="relative">
                  <input
                    type="text"
                    value={utrNumber}
                    onChange={(e) => setUtrNumber(e.target.value.replace(/[^0-9a-zA-Z]/g, ""))}
                    placeholder="e.g. 202610248912"
                    maxLength={16}
                    required
                    className="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-3.5 text-white font-mono text-base tracking-wider placeholder-slate-500 focus:outline-none focus:border-emerald-500"
                  />
                  <span className="absolute right-3 top-3.5 text-xs text-slate-500 font-mono">
                    {utrNumber.length}/12
                  </span>
                </div>
                <p className="text-[11px] text-slate-400 mt-1">
                  You can find the 12-digit UTR in your Google Pay, PhonePe, or Paytm payment receipt details.
                </p>
              </div>

              {/* OPTIONAL SCREENSHOT UPLOAD */}
              <div>
                <label className="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-2">
                  Payment Receipt Screenshot (Forwarded to Accountant Verification Queue)
                </label>
                <div className="flex items-center gap-3">
                  <label className="bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 px-4 py-2.5 rounded-xl text-xs font-bold cursor-pointer transition-colors flex items-center gap-2">
                    <Upload className="w-4 h-4 text-blue-400" />
                    <span>Upload Screenshot</span>
                    <input
                      type="file"
                      accept="image/*"
                      onChange={handleScreenshotChange}
                      className="hidden"
                    />
                  </label>
                  <span className="text-xs text-slate-400 truncate max-w-[200px]">
                    {screenshotName || "No screenshot attached (Optional)"}
                  </span>
                </div>
              </div>

              {/* ACTION BUTTONS */}
              <div className="space-y-3 pt-2">
                {/* PRIMARY ACTION: LIVE ONLINE GATEWAY CHECKOUT */}
