    .replace(/\\Delta/g, "Δ")
    .replace(/\\pm/g, "±")
    .replace(/\\sqrt\{([^}]+)\}/g, "√($1)")
    .replace(/\\sqrt/g, "√")
    .replace(/ax\^2/g, "ax²")
    .replace(/bx\^2/g, "bx²")
    .replace(/cx\^2/g, "cx²")
    .replace(/x\^2/g, "x²")
    .replace(/b\^2/g, "b²")
    .replace(/a\^2/g, "a²")
    .replace(/c\^2/g, "c²")
    .replace(/\^2/g, "²")
    .replace(/\^3/g, "³")
    .replace(/<=/g, "≤")
    .replace(/>=/g, "≥");
}

