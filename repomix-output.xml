-- STAGE 7: REVERSAL MAKER-CHECKER WORKFLOW & CONCURRENCY
-- ------------------------------------------------------------------------------
DO $$
DECLARE
  v_school_a_id uuid;
  v_school_b_id uuid;
  v_code_a text;
  v_code_b text;
  v_acc_id uuid;
  v_prin_id uuid;
