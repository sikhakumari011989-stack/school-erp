<file path="src/pages/Reports.jsx">
import { useContext, useState } from "react";
import { AppContext } from "../context/AppContext";
import { useToast } from "../context/ToastContext";

export default function Reports() {
  const { getFeeReport, getAttendanceReport, getMarksReport, classes } = useContext(AppContext);
  const { showToast } = useToast();
  const [reportType, setReportType] = useState("fees");
  const [startDate, setStartDate] = useState("");
  const [endDate, setEndDate] = useState("");
  const [classId, setClassId] = useState("");
  const [reportData, setReportData] = useState(null);

  const handleGenerateReport = () => {
    if (!startDate || !endDate) {
      showToast("Please select both start and end date range.", "error");
      return;
    }

    let data;
    if (reportType === "fees") {
      data = getFeeReport(startDate, endDate, classId || null);
    } else if (reportType === "attendance") {
      data = getAttendanceReport(startDate, endDate, classId || null);
    } else if (reportType === "marks") {
      data = getMarksReport(classId || null);
    }

    setReportData(data);
  };

  const handleDownloadCSV = () => {
    if (!reportData) return;

    let csv = "";
    if (reportType === "fees") {
      csv = "Student ID,Amount,Status,Date\n";
      reportData.records.forEach((r) => {
        csv += `${r.student_id},${r.amount},${r.status},${r.date}\n`;
      });
    } else if (reportType === "attendance") {
      csv = "Date,Present,Absent,Percentage\n";
      csv += `${reportData.total_days},${reportData.present},${reportData.absent},${reportData.percentage}%\n`;
    } else if (reportType === "marks") {
      csv = "Student,Subject,Percentage,Grade\n";
      reportData.records.forEach((r) => {
        csv += `${r.student_id},${r.subject},${r.percentage},${r.grade}\n`;
      });
    }

    const blob = new Blob([csv], { type: "text/csv" });
    const url = window.URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = `${reportType}-report.csv`;
    a.click();
  };

  return (
    <div className="p-8 bg-gradient-to-br from-slate-900 to-slate-800 min-h-[100dvh]">
      <h1 className="text-4xl font-bold text-white mb-8">📊 Reports</h1>

      {/* Filter Section */}
      <div className="bg-slate-700/50 border border-slate-600/50 rounded-xl p-6 mb-8">
        <h2 className="text-xl font-bold text-white mb-4">Generate Report</h2>
        
        <div className="space-y-4">
          {/* Report Type */}
          <div>
            <label className="block text-sm font-medium text-slate-300 mb-2">
              Report Type
            </label>
            <select
              value={reportType}
              onChange={(e) => setReportType(e.target.value)}
              className="w-full px-4 py-2 bg-slate-600/50 border border-slate-500/50 rounded-lg text-white"
            >
              <option value="fees">💰 Fee Report</option>
              <option value="attendance">📋 Attendance Report</option>
              <option value="marks">📈 Marks Report</option>
            </select>
          </div>

          {/* Class Filter */}
          <div>
            <label className="block text-sm font-medium text-slate-300 mb-2">
              Class (Optional)
            </label>
            <select
              value={classId}
              onChange={(e) => setClassId(e.target.value)}
              className="w-full px-4 py-2 bg-slate-600/50 border border-slate-500/50 rounded-lg text-white"
            >
              <option value="">All Classes</option>
              {classes.map((c) => (
                <option key={c.id} value={c.id}>
                  {c.name}
                </option>
              ))}
            </select>
          </div>

          {/* Date Range */}
          {reportType !== "marks" && (
            <div className="grid grid-cols-2 gap-4">
              <div>
                <label className="block text-sm font-medium text-slate-300 mb-2">
                  Start Date
                </label>
                <input
                  type="date"
                  value={startDate}
                  onChange={(e) => setStartDate(e.target.value)}
                  className="w-full px-4 py-2 bg-slate-600/50 border border-slate-500/50 rounded-lg text-white"
                />
              </div>
              <div>
                <label className="block text-sm font-medium text-slate-300 mb-2">
                  End Date
                </label>
                <input
                  type="date"
                  value={endDate}
                  onChange={(e) => setEndDate(e.target.value)}
                  className="w-full px-4 py-2 bg-slate-600/50 border border-slate-500/50 rounded-lg text-white"
                />
              </div>
            </div>
          )}

          <button
            onClick={handleGenerateReport}
            className="w-full py-3 bg-gradient-to-r from-blue-600 to-cyan-600 hover:from-blue-700 hover:to-cyan-700 text-white font-semibold rounded-lg transition"
          >
            🔍 Generate Report
          </button>
        </div>
      </div>

      {/* Report Display */}
      {reportData && (
        <div className="bg-slate-700/50 border border-slate-600/50 rounded-xl p-6 space-y-4">
          {reportType === "fees" && (
            <div>
              <h2 className="text-2xl font-bold text-white mb-4">💰 Fee Report</h2>
              <div className="grid grid-cols-3 gap-4 mb-6">
                <div className="bg-slate-600/50 rounded-lg p-4">
                  <p className="text-slate-400">Total Fees</p>
                  <p className="text-2xl font-bold text-green-400">
                    ₹{reportData.total_fees.toFixed(2)}
                  </p>
                </div>
                <div className="bg-slate-600/50 rounded-lg p-4">
                  <p className="text-slate-400">Collected</p>
                  <p className="text-2xl font-bold text-blue-400">
                    ₹{reportData.collected.toFixed(2)}
                  </p>
                </div>
                <div className="bg-slate-600/50 rounded-lg p-4">
                  <p className="text-slate-400">Pending</p>
                  <p className="text-2xl font-bold text-red-400">
                    ₹{reportData.pending.toFixed(2)}
                  </p>
                </div>
              </div>
            </div>
          )}

          {reportType === "attendance" && (
            <div>
              <h2 className="text-2xl font-bold text-white mb-4">📋 Attendance Report</h2>
              <div className="grid grid-cols-4 gap-4 mb-6">
                <div className="bg-slate-600/50 rounded-lg p-4">
                  <p className="text-slate-400">Total Days</p>
                  <p className="text-2xl font-bold text-white">{reportData.total_days}</p>
                </div>
                <div className="bg-slate-600/50 rounded-lg p-4">
                  <p className="text-slate-400">Present</p>
                  <p className="text-2xl font-bold text-green-400">{reportData.present}</p>
                </div>
                <div className="bg-slate-600/50 rounded-lg p-4">
                  <p className="text-slate-400">Absent</p>
                  <p className="text-2xl font-bold text-red-400">{reportData.absent}</p>
                </div>
                <div className="bg-slate-600/50 rounded-lg p-4">
                  <p className="text-slate-400">Percentage</p>
                  <p className="text-2xl font-bold text-cyan-400">{reportData.percentage}%</p>
                </div>
              </div>
            </div>
          )}

          {reportType === "marks" && (
            <div>
              <h2 className="text-2xl font-bold text-white mb-4">📈 Marks Report</h2>
              <div className="grid grid-cols-3 gap-4 mb-6">
                <div className="bg-slate-600/50 rounded-lg p-4">
                  <p className="text-slate-400">Total Students</p>
                  <p className="text-2xl font-bold text-white">{reportData.total_students}</p>
                </div>
                <div className="bg-slate-600/50 rounded-lg p-4">
                  <p className="text-slate-400">Total Marks</p>
                  <p className="text-2xl font-bold text-white">{reportData.total_marks}</p>
                </div>
                <div className="bg-slate-600/50 rounded-lg p-4">
                  <p className="text-slate-400">Class Average</p>
                  <p className="text-2xl font-bold text-yellow-400">{reportData.class_average}%</p>
                </div>
              </div>
            </div>
          )}

          <button
            onClick={handleDownloadCSV}
            className="w-full py-3 bg-gradient-to-r from-green-600 to-emerald-600 hover:from-green-700 hover:to-emerald-700 text-white font-semibold rounded-lg transition"
          >
            ⬇️ Download CSV
          </button>
        </div>
      )}
    </div>
  );
}
</file>

<file path="src/pages/StudentCalendar.jsx">
import React, { useState, useEffect, useContext } from "react";
import { AppContext } from "../context/AppContext";
import { useToast } from "../context/ToastContext";
import SchoolCalendar from "../Components/SchoolCalendar";

export default function StudentCalendar() {
  const { user } = useContext(AppContext);
  const { showToast } = useToast();
  const schoolId = user?.school_id || user?.institution_code || "CAMPUS-01";
  const userRole = (user?.role || "").toLowerCase();
  const canManage = ["teacher", "principal", "trustee", "admin"].includes(userRole);

  const [selectedMonth] = useState("Academic Session 2026-27");
  const [events, setEvents] = useState([]);
  const [showAddModal, setShowAddModal] = useState(false);
  const [eventForm, setEventForm] = useState({
    title: "",
    date: "",
    type: "Exam",
    status: "Working Day",
  });

  useEffect(() => {
    try {
      const stored = localStorage.getItem(`erp_calendar_${schoolId}`);
      if (stored) {
        setEvents(JSON.parse(stored));
      } else {
        setEvents([]);
      }
    } catch (e) {
      setEvents([]);
    }
  }, [schoolId]);

  const handleAddEvent = (e) => {
    e.preventDefault();
    if (!eventForm.title.trim() || !eventForm.date.trim()) {
      showToast("Please provide event title and date.", "error");
      return;
    }

    const newEv = {
      id: `ev_${Date.now()}`,
      title: eventForm.title.trim(),
      date: eventForm.date.trim(),
      type: eventForm.type,
      status: eventForm.status,
    };

    const updated = [...events, newEv];
    setEvents(updated);
    try {
      localStorage.setItem(`erp_calendar_${schoolId}`, JSON.stringify(updated));
    } catch (e) {}

    showToast(`Event "${newEv.title}" added to school calendar!`, "success");
    setEventForm({ title: "", date: "", type: "Exam", status: "Working Day" });
    setShowAddModal(false);
  };

  const handleDeleteEvent = (id) => {
    const updated = events.filter((e) => e.id !== id);
    setEvents(updated);
    try {
      localStorage.setItem(`erp_calendar_${schoolId}`, JSON.stringify(updated));
    } catch (e) {}
    showToast("Event removed from calendar.", "info");
  };

  return (
    <div className="relative text-slate-200 min-h-full pb-10 font-sans">
      <div className="fixed top-0 right-10 w-96 h-96 bg-emerald-600/10 rounded-full blur-[120px] pointer-events-none"></div>

      <div className="relative z-10 max-w-4xl mx-auto">
        <div className="mb-8 flex justify-between items-center flex-wrap gap-4">
          <div>
            <p className="text-emerald-300 text-sm font-semibold mb-1 uppercase tracking-widest">Student Portal</p>
            <h1 className="text-3xl font-extrabold text-white">School Calendar & Holidays 📅</h1>
            <p className="text-slate-400 text-sm mt-1">Track academic schedules, examination dates, holidays, and campus events</p>
          </div>
          <div className="flex items-center gap-3">
            <div className="bg-slate-800 border border-slate-700 px-4 py-2 rounded-xl text-white font-bold text-xs">
              {selectedMonth}
            </div>
            {canManage && (
              <button
                onClick={() => setShowAddModal(true)}
                className="bg-emerald-600 hover:bg-emerald-500 text-white font-bold px-4 py-2 rounded-xl text-xs shadow-lg shadow-emerald-600/20 transition-all cursor-pointer"
              >
                + Add Calendar Event
              </button>
            )}
          </div>
        </div>

        {/* TODAY'S STATUS BANNER */}
        <div className="bg-gradient-to-r from-emerald-600/20 to-teal-600/10 border border-emerald-500/30 rounded-3xl p-6 shadow-2xl mb-8 flex justify-between items-center">
          <div>
            <span className="text-xs font-extrabold text-emerald-400 uppercase tracking-widest">Today's Academic Status</span>
            <h2 className="text-2xl font-black text-white mt-1">Working Academic Day 📚</h2>
            <p className="text-slate-300 text-sm mt-1">Regular classes in session. Check period schedules in your student dashboard.</p>
          </div>
          <div className="text-4xl">🏫</div>
        </div>

        {/* INTERACTIVE MONTHLY STUDENT CALENDAR & DAILY ATTENDANCE STATUS */}
        <SchoolCalendar
          viewMode="student"
          studentRoll={user?.role_code || user?.roll_number || user?.personal_code}
          assignedClass={user?.class_name || "Class 10-A"}
          className="mb-8"
        />

        {/* EVENTS LIST */}
        <div className="bg-[#1E293B] border border-slate-700 rounded-3xl shadow-2xl overflow-hidden">
          <div className="p-6 border-b border-slate-700 bg-slate-800/50 flex justify-between items-center">
            <h2 className="text-lg font-bold text-white">Upcoming Academic Schedule & Holidays</h2>
            <span className="text-xs text-slate-400 font-semibold">{events.length} Events Listed</span>
          </div>

          {events.length === 0 ? (
            <div className="p-12 text-center text-slate-400">
              <div className="text-4xl mb-3">📅</div>
              <h3 className="text-lg font-bold text-white mb-1">Calendar Initialized (Clean Slate)</h3>
              <p className="text-sm max-w-md mx-auto text-slate-400 mb-6">
                No academic calendar events or holidays published yet. Your school administration will publish exam dates and holiday circulars here.
              </p>
              {canManage && (
                <button
                  onClick={() => setShowAddModal(true)}
                  className="bg-emerald-600/20 hover:bg-emerald-600/30 text-emerald-300 border border-emerald-500/30 px-5 py-2.5 rounded-xl font-bold text-xs transition-all cursor-pointer"
                >
                  + Publish First Event
                </button>
              )}
            </div>
          ) : (
            <div className="divide-y divide-slate-700/50">
              {events.map((ev, idx) => (
                <div key={ev.id || idx} className="p-6 flex justify-between items-center hover:bg-slate-800/30 transition-colors">
                  <div className="flex items-center gap-4">
                    <div className="w-16 h-16 rounded-2xl bg-slate-900 border border-slate-700 flex flex-col items-center justify-center text-center shrink-0">
                      <span className="text-xs font-bold text-emerald-400 uppercase">
                        {String(ev.date).split(" ")[0] || "DATE"}
                      </span>
                      <span className="text-lg font-black text-white">
                        {String(ev.date).split(" ")[1]?.replace(",", "") || "•"}
                      </span>
                    </div>
                    <div>
                      <span className="bg-slate-800 text-slate-300 px-3 py-0.5 rounded-md text-[10px] font-extrabold uppercase mb-1 inline-block">
                        {ev.type}
                      </span>
                      <h3 className="text-lg font-bold text-white">{ev.title}</h3>
                    </div>
                  </div>
                  <div className="flex items-center gap-3">
                    <span
                      className={`px-4 py-2 rounded-xl text-xs font-extrabold uppercase ${
                        (ev.status || "").includes("Holiday")
                          ? "bg-purple-500/20 text-purple-300 border border-purple-500/30"
                          : "bg-emerald-500/20 text-emerald-400 border border-emerald-500/30"
                      }`}
                    >
                      {ev.status}
                    </span>
                    {canManage && (
                      <button
                        onClick={() => handleDeleteEvent(ev.id)}
                        className="text-red-400 hover:text-red-300 text-xs px-2 py-1 hover:bg-red-500/10 rounded transition-colors cursor-pointer"
                        title="Delete event"
                      >
                        ✕
                      </button>
                    )}
                  </div>
                </div>
              ))}
            </div>
          )}
        </div>
      </div>

      {/* ADD EVENT MODAL */}
      {showAddModal && (
        <div className="fixed inset-0 bg-black/70 backdrop-blur-md flex items-center justify-center p-4 z-50">
          <div className="bg-[#1E293B] border border-slate-700 rounded-3xl p-6 sm:p-8 max-w-md w-full shadow-2xl">
            <h3 className="text-xl font-extrabold text-white mb-1">Add Calendar Event 📅</h3>
            <p className="text-xs text-slate-400 mb-6">Schedule examinations, campus events, or holiday notices.</p>

            <form onSubmit={handleAddEvent} className="space-y-4">
              <div>
                <label className="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Event Title</label>
                <input
                  type="text"
                  placeholder="e.g. Mid-Term Examination or Diwali Vacation"
                  value={eventForm.title}
                  onChange={(e) => setEventForm({ ...eventForm, title: e.target.value })}
                  className="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-emerald-500"
                  required
                />
              </div>

              <div>
                <label className="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Date</label>
                <input
                  type="text"
                  placeholder="e.g. Oct 20, 2026 or Nov 14, 2026"
                  value={eventForm.date}
                  onChange={(e) => setEventForm({ ...eventForm, date: e.target.value })}
                  className="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-emerald-500"
                  required
                />
              </div>

              <div>
                <label className="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Category</label>
                <select
                  value={eventForm.type}
                  onChange={(e) => setEventForm({ ...eventForm, type: e.target.value })}
                  className="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-emerald-500"
                >
                  <option value="Exam">Exam</option>
                  <option value="Holiday">Holiday</option>
                  <option value="Event">Event</option>
                  <option value="Sports">Sports</option>
                  <option value="Celebration">Celebration</option>
                </select>
              </div>

              <div>
                <label className="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Status Badge</label>
                <select
                  value={eventForm.status}
                  onChange={(e) => setEventForm({ ...eventForm, status: e.target.value })}
                  className="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-emerald-500"
                >
                  <option value="Working Day">Working Day</option>
                  <option value="Holiday 🏖️">Holiday 🏖️</option>
                  <option value="Special Schedule">Special Schedule</option>
                </select>
              </div>

              <div className="flex justify-end gap-3 pt-4">
                <button
                  type="button"
                  onClick={() => setShowAddModal(false)}
                  className="px-4 py-2 rounded-xl text-slate-400 hover:text-white font-bold text-xs"
                >
                  Cancel
                </button>
                <button
                  type="submit"
                  className="bg-emerald-600 hover:bg-emerald-500 text-white font-bold px-6 py-2.5 rounded-xl text-xs shadow-lg transition-all"
                >
                  Publish Event
                </button>
              </div>
            </form>
          </div>
        </div>
      )}
    </div>
  );
}
</file>

<file path="src/pages/StudentHomework.jsx">
import React, { useState, useEffect, useContext } from "react";
import { AppContext } from "../context/AppContext";
import { useToast } from "../context/ToastContext";
import { supabase } from "../supabaseClient";
import { TableSkeleton } from "../Components/Skeleton";

export default function StudentHomework() {
  const { user } = useContext(AppContext);
  const { showToast } = useToast();
  const [homeworkList, setHomeworkList] = useState([]);
  const [loading, setLoading] = useState(true);
  const [completions, setCompletions] = useState({});

  const schoolId = (user?.institution_code || user?.school_id || "CAMPUS-01").toUpperCase();
  const studentId = (user?.personal_code || user?.role_code || user?.roll_number || user?.id || "STU-101").toUpperCase();

  const loadCompletions = () => {
    try {
      const saved = localStorage.getItem(`erp_hw_completion_${schoolId}`);
      if (saved) {
        setCompletions(JSON.parse(saved));
      } else {
        setCompletions({});
      }
    } catch {
      setCompletions({});
    }
  };

  const fetchHomework = async () => {
    setLoading(true);
    loadCompletions();
    try {
      const { data, error } = await supabase
        .from("homework")
        .select("*")
        .eq("school_id", schoolId)
        .order("created_at", { ascending: false });

      if (error) throw error;
      setHomeworkList(data || []);
    } catch (err) {
      console.error("Error fetching student homework:", err);
      // Fallback to local storage if offline
      try {
        const local = JSON.parse(localStorage.getItem(`erp_homework_${schoolId}`) || "[]");
        setHomeworkList(local);
      } catch (e) {
        setHomeworkList([]);
      }
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    fetchHomework();
    const handleUpdate = () => loadCompletions();
    window.addEventListener("erp-homework-verification-updated", handleUpdate);
    return () => window.removeEventListener("erp-homework-verification-updated", handleUpdate);
  }, [user?.institution_code, user?.school_id]);

  const isHwCompleted = (hwId) => {
    if (!completions) return false;
    // Check if verified specifically for this student, or verified globally for the assignment
    if (completions[hwId] === true) return true;
    if (completions[hwId] && typeof completions[hwId] === "object" && (completions[hwId][studentId] === true || completions[hwId]["all"] === true)) {
      return true;
    }
    return false;
  };

  const completedCount = homeworkList.filter((h) => isHwCompleted(h.id)).length;
  const pendingCount = homeworkList.length - completedCount;

  return (
    <div className="relative text-slate-200 min-h-full pb-10 font-sans">
      <div className="fixed top-0 left-10 w-96 h-96 bg-blue-600/10 rounded-full blur-[120px] pointer-events-none"></div>

      <div className="relative z-10 max-w-5xl mx-auto">
        <div className="mb-8 flex justify-between items-center flex-wrap gap-4">
          <div>
            <p className="text-blue-300 text-sm font-semibold mb-1 uppercase tracking-widest">
              Student Academic Portal
            </p>
            <h1 className="text-3xl font-extrabold text-white">Curriculum Assignments & Homework 📚</h1>
            <p className="text-slate-400 text-sm mt-1">
              Strict faculty verification system &bull; Student status: <span className="font-mono text-blue-400 font-bold">{studentId}</span>
            </p>
          </div>
          <div className="flex items-center gap-3">
            <span className="bg-slate-800 border border-slate-700 text-emerald-300 px-4 py-2 rounded-xl text-sm font-bold">
              ✓ Verified: {completedCount}
            </span>
            <span className="bg-slate-800 border border-slate-700 text-amber-300 px-4 py-2 rounded-xl text-sm font-bold">
              ⏳ Pending: {pendingCount}
            </span>
            <button
              onClick={fetchHomework}
              className="text-xs bg-blue-600/20 hover:bg-blue-600/30 text-blue-300 border border-blue-500/30 px-3.5 py-2 rounded-xl font-bold transition-all cursor-pointer"
            >
              🔄 Refresh
            </button>
          </div>
        </div>

        {loading ? (
          <div className="bg-[#1E293B]/70 rounded-3xl p-6 border border-slate-700/60">
            <TableSkeleton rows={4} cols={3} />
          </div>
        ) : homeworkList.length === 0 ? (
          <div className="bg-[#1E293B]/70 border border-slate-700/60 rounded-3xl p-16 text-center shadow-2xl">
            <span className="text-5xl block mb-4">🎉</span>
            <h3 className="text-xl font-bold text-white mb-2">No Homework Assigned</h3>
            <p className="text-slate-400 text-sm max-w-md mx-auto">
              Your faculty has not published any assignments for your batch. Check back regularly or enjoy your study break!
            </p>
          </div>
        ) : (
          <div className="space-y-4">
            {homeworkList.map((hw) => {
              const isCompleted = isHwCompleted(hw.id);
              return (
                <div
                  key={hw.id}
                  className={`bg-[#1E293B]/70 backdrop-blur-xl border rounded-3xl p-6 shadow-xl transition-all duration-300 ${
                    isCompleted
                      ? "border-emerald-500/40 bg-emerald-950/20"
                      : "border-slate-700/60 hover:border-blue-500/40"
                  }`}
                >
                  <div className="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-4">
                    <div className="flex items-center gap-3 flex-wrap">
                      <span className="bg-blue-500/20 text-blue-400 border border-blue-500/30 px-3 py-1 rounded-xl text-xs font-black uppercase">
                        {hw.subject}
                      </span>
                      <h3 className="text-lg font-bold text-white">{hw.title}</h3>
                    </div>
                    <div className="flex items-center gap-2">
                      <span className="text-xs text-slate-400">Deadline:</span>
                      <span className="bg-slate-900 border border-slate-700 text-amber-400 px-3 py-1 rounded-lg text-xs font-bold font-mono">
                        {hw.due_date || "No deadline"}
                      </span>
                    </div>
                  </div>

                  <p className="text-slate-300 text-sm leading-relaxed mb-6 bg-slate-900/50 p-4 rounded-2xl border border-slate-800">
                    {hw.description || "No specific instructions provided."}
                  </p>

                  <div className="flex justify-between items-center pt-2 flex-wrap gap-3">
                    <span className="text-xs text-slate-400 font-mono">
                      Posted: {new Date(hw.created_at).toLocaleDateString()}
                    </span>
                    <div>
                      {isCompleted ? (
                        <span className="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 shadow-lg shadow-emerald-900/20">
                          <span>✓</span>
                          <span>Verified Completed by Faculty</span>
                        </span>
                      ) : (
                        <span className="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-bold bg-amber-500/20 text-amber-400 border border-amber-500/40 shadow-lg shadow-amber-900/20">
                          <span>⏳</span>
                          <span>Pending Faculty Verification</span>
                        </span>
                      )}
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        )}
      </div>
    </div>
  );
}
</file>

<file path="src/pages/StudentLMS.jsx">
import React, { useState, useEffect, useContext } from "react";
import { AppContext } from "../context/AppContext";
import { getQuizzes } from "../utils/quizService";
import { getStudyMaterials } from "../utils/studyMaterialService";
import { useToast } from "../context/ToastContext";

export function formatMathText(text) {
  if (!text || typeof text !== "string") return text;
  return text
    .replace(/\$\$([^$]+)\$\$/g, "$1")
    .replace(/\$([^$]+)\$/g, "$1")
    .replace(/\\Delta/g, "Δ")
    .replace(/\\pm/g, "±")
    .replace(/\\sqrt\{([^}]+)\}/g, "√($1)")
    .replace(/\\sqrt/g, "√")
    .replace(/ax\^2/g, "ax²")
    .replace(/bx\^2/g, "bx²")
    .replace(/cx\^2/g, "cx²")
    .replace(/x\^2/g, "x²")
    .replace(/b\^2/g, "b²")
    .replace(/a\^2/g, "a²")
    .replace(/c\^2/g, "c²")
    .replace(/\^2/g, "²")
    .replace(/\^3/g, "³")
    .replace(/<=/g, "≤")
    .replace(/>=/g, "≥");
}

export default function StudentLMS() {
  const { user } = useContext(AppContext);
  const { showToast } = useToast();

  const [activeTab, setActiveTab] = useState("lms"); // 'lms' or 'quizzes'
  const [quizzes, setQuizzes] = useState([]);
  const [loadingQuizzes, setLoadingQuizzes] = useState(true);

  // Dynamic study materials uploaded by faculty (Clean Slate)
  const [materials, setMaterials] = useState([]);
  const [loadingMaterials, setLoadingMaterials] = useState(true);

  // Quiz state
  const [selectedQuiz, setSelectedQuiz] = useState(null);
  const [currentQIndex, setCurrentQIndex] = useState(0);
  const [userAnswers, setUserAnswers] = useState({});
  const [scoreResult, setScoreResult] = useState(null);

  const schoolCode = user?.school_id || user?.institution_code;

  const loadLmsContent = async () => {
    setLoadingQuizzes(true);
    setLoadingMaterials(true);
    try {
      const [qData, mData] = await Promise.all([
        getQuizzes(schoolCode),
        getStudyMaterials(schoolCode),
      ]);
      setQuizzes(qData || []);
      setMaterials(mData || []);
    } catch (err) {
      console.error("Error loading LMS data:", err);
    } finally {
      setLoadingQuizzes(false);
      setLoadingMaterials(false);
    }
  };

  useEffect(() => {
    loadLmsContent();
    window.addEventListener("erp-quizzes-updated", loadLmsContent);
    window.addEventListener("erp-study-materials-updated", loadLmsContent);
    return () => {
      window.removeEventListener("erp-quizzes-updated", loadLmsContent);
      window.removeEventListener("erp-study-materials-updated", loadLmsContent);
    };
  }, [schoolCode]);

  const handleStartQuiz = (quiz) => {
    setSelectedQuiz(quiz);
    setCurrentQIndex(0);
    setUserAnswers({});
    setScoreResult(null);
  };

  const handleSelectOption = (qIdx, optIdx) => {
    setUserAnswers((prev) => ({
      ...prev,
      [qIdx]: optIdx,
    }));
  };

  const handleSubmitQuiz = () => {
    if (!selectedQuiz || !selectedQuiz.questions || selectedQuiz.questions.length === 0) return;

    let correctCount = 0;
    const details = selectedQuiz.questions.map((q, idx) => {
      const selected = userAnswers[idx];
      const isCorrect = selected === q.correct_answer;
      if (isCorrect) correctCount += 1;
      return {
        question: q.question,
        options: q.options,
        selectedOption: selected !== undefined ? q.options[selected] : "Not Answered",
        correctOption: q.options[q.correct_answer],
        isCorrect,
        explanation: q.explanation || "Standard curriculum concept.",
      };
    });

    const total = selectedQuiz.questions.length;
    const percentage = Math.round((correctCount / total) * 100);

    setScoreResult({
      correctCount,
      total,
      percentage,
      details,
    });

    showToast(`Quiz submitted! You scored ${percentage}% (${correctCount}/${total})`, "success");
  };

  const handleDownloadResource = (mat) => {
    showToast(`Downloading "${mat.title}" (${mat.size})...`, "info");
  };

  return (
    <div className="relative text-slate-200 min-h-full pb-10 font-sans">
      <div className="fixed top-0 left-10 w-96 h-96 bg-purple-600/10 rounded-full blur-[120px] pointer-events-none"></div>

      <div className="relative z-10 max-w-6xl mx-auto">
        {/* HEADER */}
        <div className="mb-8 flex justify-between items-center flex-wrap gap-4">
          <div>
            <p className="text-purple-300 text-sm font-semibold mb-1 uppercase tracking-widest">
              Student Academic Learning Management System
            </p>
            <h1 className="text-3xl font-extrabold text-white">LMS Study Hub & Quizzes 📖</h1>
            <p className="text-slate-400 text-sm mt-1">
              Interactive faculty study notes, term revision sheets, and dynamic automated test series
            </p>
          </div>
          <div className="flex gap-2 bg-slate-800/80 p-1.5 rounded-2xl border border-slate-700">
            <button
              onClick={() => setActiveTab("lms")}
              className={`px-5 py-2.5 rounded-xl font-bold text-sm transition-all cursor-pointer ${
                activeTab === "lms"
                  ? "bg-purple-600 text-white shadow-lg shadow-purple-600/30"
                  : "text-slate-400 hover:text-white"
              }`}
            >
              📚 LMS Study Vault
            </button>
            <button
              onClick={() => setActiveTab("quizzes")}
              className={`px-5 py-2.5 rounded-xl font-bold text-sm transition-all cursor-pointer ${
                activeTab === "quizzes"
                  ? "bg-purple-600 text-white shadow-lg shadow-purple-600/30"
                  : "text-slate-400 hover:text-white"
              }`}
            >
              ⚡ Interactive Quizzes ({quizzes.length})
            </button>
          </div>
        </div>

        {/* TAB 1: STUDY MATERIALS */}
        {activeTab === "lms" ? (
          <div>
            {loadingMaterials ? (
              <div className="text-center py-12 text-slate-400">Loading syllabus study materials...</div>
            ) : materials.length === 0 ? (
              <div className="p-12 text-center bg-[#1E293B]/70 border border-slate-700/60 rounded-3xl text-slate-400 space-y-3">
                <div className="text-5xl opacity-60">📚</div>
                <h3 className="text-lg font-bold text-white">No study notes or interactive quizzes uploaded by faculty yet.</h3>
                <p className="text-xs text-slate-400 max-w-md mx-auto">
                  When your subject teachers upload chapter notes, revision formula sheets, or reference documents, they will appear here for download.
                </p>
              </div>
            ) : (
              <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {materials.map((mat) => (
                  <div
                    key={mat.id}
                    className="bg-[#1E293B]/70 backdrop-blur-xl border border-slate-700/60 rounded-3xl p-6 shadow-2xl flex flex-col justify-between group hover:border-purple-500/50 transition-all"
                  >
                    <div>
                      <div className="flex justify-between items-center mb-4">
                        <span className="bg-purple-500/20 text-purple-300 border border-purple-500/30 px-3 py-1 rounded-xl text-xs font-bold uppercase">
                          {mat.subject}
                        </span>
                        <span className="text-slate-400 text-xs font-mono font-bold">{mat.size || "PDF"}</span>
                      </div>
                      <h3 className="text-lg font-bold text-white mb-2 group-hover:text-purple-300 transition-colors">
                        {mat.title}
                      </h3>
                      <p className="text-slate-400 text-xs mb-6">
                        {mat.description || `Verified reference document uploaded by ${mat.author || "faculty"} for semester revision.`}
                      </p>
                    </div>
                    <button
                      onClick={() => handleDownloadResource(mat)}
                      className="w-full bg-slate-800/80 hover:bg-purple-600 text-white font-bold py-3 px-4 rounded-xl transition-all border border-slate-700 hover:border-purple-500 flex items-center justify-center gap-2 text-xs cursor-pointer"
                    >
                      <span>📥</span> Download PDF Resource
                    </button>
                  </div>
                ))}
              </div>
            )}
          </div>
        ) : (
          /* TAB 2: INTERACTIVE QUIZZES */
          <div>
            {selectedQuiz ? (
              /* ACTIVE QUIZ EXPERIENCE */
              <div className="bg-[#1E293B]/80 backdrop-blur-2xl border border-slate-700/60 rounded-3xl p-6 sm:p-8 shadow-2xl max-w-3xl mx-auto">
                {/* QUIZ HEADER */}
                <div className="flex justify-between items-center mb-6 border-b border-slate-700/80 pb-4">
                  <div>
                    <span className="text-xs font-bold uppercase text-purple-400">
                      {selectedQuiz.subject} • {selectedQuiz.className || "Class 10 ICSE"}
                    </span>
                    <h2 className="text-xl sm:text-2xl font-black text-white">{selectedQuiz.title}</h2>
                  </div>
                  <button
                    onClick={() => setSelectedQuiz(null)}
                    className="text-slate-400 hover:text-white font-bold text-xs bg-slate-800 px-3 py-1.5 rounded-lg border border-slate-700 cursor-pointer"
                  >
                    ✕ Exit Quiz
                  </button>
                </div>

                {scoreResult !== null ? (
                  /* SCORE BREAKDOWN & PERFORMANCE REPORT */
                  <div className="space-y-6">
                    <div className="text-center py-6 bg-slate-900/60 border border-slate-800 rounded-3xl space-y-2">
                      <div className="text-5xl">
                        {scoreResult.percentage >= 75 ? "🏆" : scoreResult.percentage >= 50 ? "🎯" : "📖"}
                      </div>
                      <h3 className="text-2xl font-black text-white">Quiz Completed!</h3>
                      <p className="text-slate-400 text-sm">
                        You answered{" "}
                        <span className="text-white font-bold">
                          {scoreResult.correctCount} of {scoreResult.total}
                        </span>{" "}
                        questions correctly.
                      </p>
                      <div className="pt-2">
                        <span
                          className={`text-4xl font-black px-4 py-1.5 rounded-2xl ${
                            scoreResult.percentage >= 75
                              ? "text-emerald-400 bg-emerald-500/10 border border-emerald-500/30"
                              : scoreResult.percentage >= 50
                              ? "text-amber-400 bg-amber-500/10 border border-amber-500/30"
                              : "text-rose-400 bg-rose-500/10 border border-rose-500/30"
                          }`}
                        >
                          {scoreResult.percentage}%
                        </span>
                      </div>
                    </div>

                    {/* DETAILED QUESTION-BY-QUESTION REVIEW */}
                    <div className="space-y-4">
                      <h4 className="text-xs font-bold uppercase tracking-wider text-slate-400">
                        Detailed Answer Review
                      </h4>
                      {scoreResult.details.map((item, idx) => (
                        <div
                          key={idx}
                          className={`p-4 rounded-2xl border text-sm space-y-2 ${
                            item.isCorrect
                              ? "bg-emerald-950/20 border-emerald-500/30"
                              : "bg-rose-950/20 border-rose-500/30"
                          }`}
                        >
                          <div className="flex justify-between items-start gap-2">
                            <p className="font-bold text-white">
                              {idx + 1}. {formatMathText(item.question)}
                            </p>
                            <span
                              className={`text-xs font-black uppercase px-2 py-0.5 rounded ${
                                item.isCorrect
                                  ? "bg-emerald-500/20 text-emerald-400"
                                  : "bg-rose-500/20 text-rose-400"
                              }`}
                            >
                              {item.isCorrect ? "Correct ✓" : "Incorrect ✗"}
                            </span>
                          </div>
                          <div className="text-xs space-y-1">
                            <p className="text-slate-300">
                              Your Answer:{" "}
                              <span
                                className={
                                  item.isCorrect ? "text-emerald-400 font-bold" : "text-rose-400 font-bold"
                                }
                              >
                                {formatMathText(item.selectedOption)}
                              </span>
                            </p>
                            {!item.isCorrect && (
                              <p className="text-emerald-400">
                                Correct Answer: <span className="font-bold">{formatMathText(item.correctOption)}</span>
                              </p>
                            )}
                            <p className="text-slate-400 italic pt-1">💡 {formatMathText(item.explanation)}</p>
                          </div>
                        </div>
                      ))}
                    </div>

                    <div className="flex gap-3 pt-2">
                      <button
                        onClick={() => handleStartQuiz(selectedQuiz)}
                        className="flex-1 bg-slate-800 hover:bg-slate-700 text-white font-bold py-3.5 px-4 rounded-xl border border-slate-700 transition-all text-xs cursor-pointer"
                      >
                        🔄 Retake Quiz
                      </button>
                      <button
                        onClick={() => setSelectedQuiz(null)}
                        className="flex-1 bg-purple-600 hover:bg-purple-500 text-white font-bold py-3.5 px-4 rounded-xl shadow-lg shadow-purple-600/30 transition-all text-xs cursor-pointer"
                      >
                        Back to Quizzes
                      </button>
                    </div>
                  </div>
                ) : (
                  /* QUIZ QUESTION INTERACTION */
                  <div className="space-y-6">
                    {selectedQuiz.questions && selectedQuiz.questions.length > 0 ? (
                      <div>
                        {/* PROGRESS BAR */}
                        <div className="flex justify-between items-center text-xs font-bold text-slate-400 mb-2">
                          <span>
                            Question {currentQIndex + 1} of {selectedQuiz.questions.length}
                          </span>
                          <span className="text-purple-400">
                            {Object.keys(userAnswers).length} answered
                          </span>
                        </div>
                        <div className="w-full bg-slate-800 h-2 rounded-full overflow-hidden mb-6">
                          <div
                            className="bg-purple-500 h-full transition-all duration-300"
                            style={{
                              width: `${((currentQIndex + 1) / selectedQuiz.questions.length) * 100}%`,
                            }}
                          ></div>
                        </div>

                        {/* QUESTION BOX */}
                        {(() => {
                          const currentQ = selectedQuiz.questions[currentQIndex];
                          if (!currentQ) return null;

                          return (
                            <div className="space-y-5">
                              <div className="bg-slate-900/70 p-5 rounded-2xl border border-slate-800">
                                <span className="text-[10px] font-black uppercase tracking-wider text-purple-400 bg-purple-500/10 border border-purple-500/20 px-2.5 py-1 rounded-full inline-block mb-3">
                                  Question {currentQIndex + 1}
                                </span>
                                <h3 className="text-base sm:text-lg font-bold text-white leading-relaxed">
                                  {formatMathText(currentQ.question)}
                                </h3>
                              </div>

                              {/* 4 OPTIONS */}
                              <div className="space-y-3">
                                {currentQ.options.map((opt, optIdx) => {
                                  const isSelected = userAnswers[currentQIndex] === optIdx;
                                  return (
                                    <div
                                      key={optIdx}
                                      onClick={() => handleSelectOption(currentQIndex, optIdx)}
                                      className={`p-4 rounded-2xl border cursor-pointer transition-all flex items-center gap-3 ${
                                        isSelected
                                          ? "bg-purple-600/20 border-purple-500 shadow-md shadow-purple-600/20 text-white"
                                          : "bg-slate-900/60 border-slate-800 text-slate-300 hover:border-slate-700"
                                      }`}
                                    >
                                      <div
                                        className={`w-6 h-6 rounded-full border flex items-center justify-center text-xs font-black flex-shrink-0 ${
                                          isSelected
                                            ? "border-purple-400 bg-purple-600 text-white"
                                            : "border-slate-700 text-slate-400"
                                        }`}
                                      >
                                        {String.fromCharCode(65 + optIdx)}
                                      </div>
                                      <span className="font-semibold text-sm">{formatMathText(opt)}</span>
                                    </div>
                                  );
                                })}
                              </div>

                              {/* NAVIGATION & SUBMIT BUTTONS */}
                              <div className="flex justify-between items-center pt-4">
                                <button
                                  type="button"
                                  onClick={() => setCurrentQIndex((prev) => Math.max(0, prev - 1))}
                                  disabled={currentQIndex === 0}
                                  className="bg-slate-800 hover:bg-slate-700 text-slate-300 disabled:opacity-40 font-bold py-2.5 px-4 rounded-xl border border-slate-700 text-xs transition-all cursor-pointer"
                                >
                                  ← Previous
                                </button>

                                {currentQIndex < selectedQuiz.questions.length - 1 ? (
                                  <button
                                    type="button"
                                    onClick={() =>
                                      setCurrentQIndex((prev) =>
                                        Math.min(selectedQuiz.questions.length - 1, prev + 1)
                                      )
                                    }
                                    className="bg-purple-600 hover:bg-purple-500 text-white font-bold py-2.5 px-5 rounded-xl text-xs transition-all cursor-pointer"
                                  >
                                    Next Question →
                                  </button>
                                ) : (
                                  <button
                                    type="button"
                                    onClick={handleSubmitQuiz}
                                    className="bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white font-black py-3 px-6 rounded-xl shadow-lg shadow-emerald-600/30 text-xs transition-all cursor-pointer"
                                  >
                                    Submit Final Quiz Answers 🚀
                                  </button>
                                )}
                              </div>
                            </div>
                          );
                        })()}
                      </div>
                    ) : (
                      <p className="text-center text-slate-400 py-6">No questions loaded for this quiz.</p>
                    )}
                  </div>
                )}
              </div>
            ) : (
              /* QUIZZES LIST */
              <div>
                {loadingQuizzes ? (
                  <div className="text-center py-12 text-slate-400">Loading interactive quizzes...</div>
                ) : quizzes.length === 0 ? (
                  <div className="p-12 text-center bg-[#1E293B]/70 border border-slate-700/60 rounded-3xl text-slate-400 space-y-3">
                    <div className="text-5xl opacity-60">⚡</div>
                    <h3 className="text-lg font-bold text-white">No study notes or interactive quizzes uploaded by faculty yet.</h3>
                    <p className="text-xs text-slate-400 max-w-md mx-auto">
                      Your departmental faculty has not published any live quiz tests for this batch yet. Check back following classroom lessons.
                    </p>
                  </div>
                ) : (
                  <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                    {quizzes.map((q) => (
                      <div
                        key={q.id}
                        className="bg-[#1E293B]/70 backdrop-blur-xl border border-slate-700/60 rounded-3xl p-6 shadow-2xl flex flex-col justify-between hover:border-purple-500/50 transition-all group"
                      >
                        <div>
                          <div className="flex justify-between items-center mb-3">
                            <span className="bg-purple-500/20 text-purple-300 border border-purple-500/30 px-3 py-1 rounded-xl text-xs font-bold uppercase">
                              {q.subject}
                            </span>
                            <span className="text-slate-400 text-xs font-mono font-bold">
                              ⏱️ {q.duration || "15 mins"}
                            </span>
                          </div>
                          <h3 className="text-lg font-bold text-white mb-2 group-hover:text-purple-300 transition-colors">
                            {q.title}
                          </h3>
                          <p className="text-slate-400 text-xs mb-4">
                            Batch: <span className="text-slate-300 font-semibold">{q.className || "Class 10 ICSE"}</span> |{" "}
                            Questions: <span className="text-emerald-400 font-bold">{q.questions?.length || 0}</span>
                          </p>
                        </div>
                        <button
                          onClick={() => handleStartQuiz(q)}
                          className="w-full bg-purple-600 hover:bg-purple-500 text-white font-extrabold py-3 px-4 rounded-xl shadow-lg shadow-purple-600/30 transition-all text-xs flex items-center justify-center gap-2 cursor-pointer"
                        >
                          <span>🚀</span> Start Interactive Quiz
                        </button>
                      </div>
                    ))}
                  </div>
                )}
              </div>
            )}
          </div>
        )}
      </div>
    </div>
  );
}
