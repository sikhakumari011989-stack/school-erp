  RAISE NOTICE '====================================================================';
  RAISE NOTICE 'STAGE 7: VERIFYING REVERSAL MAKER-CHECKER WORKFLOW';
  RAISE NOTICE '====================================================================';

  SELECT val_uuid INTO v_school_a_id FROM tmp_test_fixture_context WHERE key = 'school_a_id';
