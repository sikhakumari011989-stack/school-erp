          .eq("date", todayDate)
          .maybeSingle();

        const currentRecords = Array.isArray(existingRecord?.records) ? existingRecord.records : [];
        const existingEventIds = new Set(
          currentRecords.map((r) => `${r.device_serial || r.device_id}:${r.vendor_event_id || r.user_code}`)
        );

