        RAISE EXCEPTION 'CRITICAL COMPLIANCE FAILURE: Authenticated user deleted records from audit_logs!';
      END IF;
    END IF;
  END IF;
  RAISE NOTICE 'VERIFIED: 10.3 — audit_logs table is immutable. Modification and deletion strictly rejected.';

