        institutionCode: cleanCode,
        adminName: formData.adminName,
        adminId: formData.adminRoleCode,
        adminRole: explicitRole,
        password: cleanPass,
        phone: formData.phone,
        email: standardEmail,
        address: formData.address,
        institutionMode: formData.institutionMode,
      });

