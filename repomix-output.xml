  )
  VALUES (
    v_clean_code, TRIM(p_name), TRIM(p_admin_phone), TRIM(p_address), 'active', 'active', p_tier, v_expires_at, p_mode, now()
  )
  ON CONFLICT (code) DO UPDATE
