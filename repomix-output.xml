-- SUPABASE MIGRATION: 19_master_setup_and_licensing.sql
-- Production Master Provisioning Engine, Institutional Licensing & Persistent RLS
-- ==============================================================================

-- 1. ADD INSTITUTIONAL LICENSING & STATUS COLUMNS TO SCHOOLS TABLE
