    const link = document.createElement("a");
    link.href = url;
    link.download = `timetable_bulk_import_template_${schoolId.toLowerCase()}.csv`;
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    showToast("Downloaded sample timetable CSV template.", "info");
  };

  const handleFileUpload = async (e) => {
    const file = e.target.files?.[0];
    if (!file) return;

    try {
      const text = await file.text();
      const lines = text.split(/\r?\n/).map((l) => l.trim()).filter(Boolean);
      if (lines.length < 2) {
        showToast("CSV file must contain a header and at least one period row.", "error");
        return;
      }

      const headers = lines[0].split(",").map((h) => h.trim().toLowerCase().replace(/['"]/g, ""));
      const classIdx = headers.findIndex((h) => h.includes("class") || h.includes("batch"));
      const dayIdx = headers.findIndex((h) => h.includes("day"));
      const startIdx = headers.findIndex((h) => h.includes("start"));
      const endIdx = headers.findIndex((h) => h.includes("end"));
      const subjectIdx = headers.findIndex((h) => h.includes("subject"));
      const teacherIdx = headers.findIndex((h) => h.includes("teacher") || h.includes("faculty"));
      const roomIdx = headers.findIndex((h) => h.includes("room") || h.includes("class"));

      if (dayIdx === -1 || subjectIdx === -1 || teacherIdx === -1) {
        showToast("CSV must contain at least Day_Of_Week, Subject, and Teacher_Name columns.", "error");
        return;
      }

      const parsed = [];
      const errors = [];

      lines.slice(1).forEach((line, index) => {
        const cols = line.split(",").map((c) => c.trim().replace(/^"|"$/g, ""));
        const rawClass = classIdx !== -1 ? cols[classIdx] : "Class 10-A";
        const rawDay = cols[dayIdx] || "";
        const rawStart = startIdx !== -1 ? cols[startIdx] : "08:30 AM";
        const rawEnd = endIdx !== -1 ? cols[endIdx] : "09:15 AM";
        const rawSubject = cols[subjectIdx] || "";
        const rawTeacher = cols[teacherIdx] || "";
        const rawRoom = roomIdx !== -1 ? cols[roomIdx] : "Room 101";

        const rowErrors = [];

        // Validate Day
        const normalizedDay = DAYS.find((d) => d.toLowerCase() === rawDay.toLowerCase());
        if (!normalizedDay) {
          rowErrors.push(`Invalid Day: "${rawDay}". Must be Monday-Saturday.`);
        }
        if (!rawSubject) {
          rowErrors.push("Subject cannot be empty.");
        }
        if (!rawTeacher) {
          rowErrors.push("Teacher name cannot be empty.");
        }

        const isValid = rowErrors.length === 0;

        parsed.push({
          rowNum: index + 2,
          day: normalizedDay || rawDay,
          className: rawClass || "General Batch",
          startTime: rawStart,
          endTime: rawEnd,
          timeWindow: `${rawStart} - ${rawEnd}`,
          subject: rawSubject,
          teacher: rawTeacher,
          room: rawRoom || "Room 101",
          isValid,
          errors: rowErrors,
        });

        if (!isValid) {
          errors.push(`Row ${index + 2}: ${rowErrors.join("; ")}`);
        }
      });

      setParsedRows(parsed);
      setImportErrors(errors);
      setImportSummary({
        total: parsed.length,
        valid: parsed.filter((r) => r.isValid).length,
        invalid: parsed.filter((r) => !r.isValid).length,
      });

      showToast(`Parsed ${parsed.length} rows (${parsed.filter((r) => r.isValid).length} valid). Check preview below.`, "info");
    } catch (err) {
      console.error("Timetable CSV parse error:", err);
      showToast("Failed to parse timetable CSV file.", "error");
    }
  };

  const handleCommitBulkImport = () => {
    const validRows = parsedRows.filter((r) => r.isValid);
    if (validRows.length === 0) {
      showToast("No valid rows to import.", "error");
      return;
    }

    const newPeriods = validRows.map((r, i) => ({
      id: `period_bulk_${Date.now()}_${i}`,
      day: r.day,
      periodNo: `Period ${i + 1}`,
      timeWindow: r.timeWindow,
      className: r.className,
      subject: r.subject,
      teacher: r.teacher,
      room: r.room,
    }));

    const merged = [...schedule, ...newPeriods];
    setSchedule(merged);
    try {
      localStorage.setItem(`erp_master_timetable_${schoolId}`, JSON.stringify(merged));
      window.dispatchEvent(new Event("erp-timetable-updated"));
    } catch (e) {}

    logSecurityAction({
      action: "TIMETABLE_BULK_IMPORTED",
      entityType: "TIMETABLE",
      entityId: schoolId,
      details: `Bulk imported ${newPeriods.length} timetable periods across Monday-Saturday tabs`,
      user,
      schoolId,
    });

    showToast(`Successfully hydrated ${newPeriods.length} periods into Monday-Saturday schedule!`, "success");
    setShowImportModal(false);
    setParsedRows([]);
    setImportErrors([]);
  };

  const getSubjectAccent = (subject = "") => {
    const s = String(subject).toLowerCase();
    if (s.includes("math") || s.includes("calculus") || s.includes("algebra") || s.includes("geom")) {
      return "bg-amber-500/15 text-amber-300 border-amber-500/40 shadow-[0_0_12px_rgba(245,158,11,0.2)]";
    }
    if (s.includes("physic") || s.includes("mechanic") || s.includes("quantum")) {
      return "bg-cyan-500/15 text-cyan-300 border-cyan-500/40 shadow-[0_0_12px_rgba(6,182,212,0.2)]";
    }
    if (s.includes("chem") || s.includes("organic") || s.includes("inorganic")) {
      return "bg-emerald-500/15 text-emerald-300 border-emerald-500/40 shadow-[0_0_12px_rgba(16,185,129,0.2)]";
    }
    if (s.includes("bio") || s.includes("botany") || s.includes("zoology") || s.includes("life")) {
      return "bg-rose-500/15 text-rose-300 border-rose-500/40 shadow-[0_0_12px_rgba(244,63,94,0.2)]";
    }
    if (s.includes("comp") || s.includes("code") || s.includes("ai") || s.includes("python") || s.includes("cs")) {
      return "bg-purple-500/15 text-purple-300 border-purple-500/40 shadow-[0_0_12px_rgba(168,85,247,0.2)]";
    }
    if (s.includes("eng") || s.includes("lit") || s.includes("grammar") || s.includes("lang")) {
      return "bg-sky-500/15 text-sky-300 border-sky-500/40 shadow-[0_0_12px_rgba(14,165,233,0.2)]";
    }
    if (s.includes("hist") || s.includes("geo") || s.includes("social") || s.includes("civics")) {
      return "bg-orange-500/15 text-orange-300 border-orange-500/40 shadow-[0_0_12px_rgba(249,115,22,0.2)]";
    }
    return "bg-slate-900 border-slate-700 text-cyan-300";
  };

  const filteredPeriods = schedule.filter((p) => p.day === selectedDay);

  return (
    <div className="space-y-6">
      {/* HEADER BANNER */}
      <div className="bg-slate-900/40 backdrop-blur-2xl border border-slate-800/50 hover:border-cyan-500/30 transition-all duration-500 hover:shadow-[0_0_30px_rgba(6,182,212,0.15)] rounded-3xl p-6 sm:p-8 shadow-2xl flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
        <div>
          <div className="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-cyan-400 text-xs font-bold uppercase tracking-wider mb-2">
            <span>⏰</span> Master Curriculum Scheduling
          </div>
          <h2 className="text-2xl font-black text-white">Master Timetable & Period Scheduler</h2>
          <p className="text-slate-400 text-sm mt-1 max-w-xl">
            Configure Monday–Saturday classroom bell timings, subject allocations, classroom numbers, and faculty assignments. Bulk upload via CSV or add individual periods.
          </p>
        </div>

        <div className="flex items-center gap-3 flex-wrap">
          <button
            type="button"
            onClick={handleAutoOptimize}
            className="bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white font-bold px-4 py-2.5 rounded-xl text-xs sm:text-sm shadow-lg shadow-emerald-600/30 transition-all cursor-pointer flex items-center gap-2"
            title="Algorithmically generate 100% conflict-free timetable across all standard batches"
          >
            <Sparkles className="w-4 h-4" />
            <span>AI Auto-Optimize Schedule</span>
          </button>
          <button
            type="button"
            disabled={publishing}
            onClick={handlePublishOfficial}
            className={`font-bold px-4 py-2.5 rounded-xl text-xs sm:text-sm shadow-lg transition-all cursor-pointer flex items-center gap-2 ${
              conflictAnalysis.isConflictFree
                ? "bg-blue-600 hover:bg-blue-500 text-white shadow-blue-600/30"
