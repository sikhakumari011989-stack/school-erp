    IF NOT v_blocked THEN
      IF EXISTS (SELECT 1 FROM public.audit_logs WHERE id = v_test_log_id AND action = 'MODIFIED') THEN
        RAISE EXCEPTION 'CRITICAL COMPLIANCE FAILURE: Authenticated user modified audit_logs table!';
