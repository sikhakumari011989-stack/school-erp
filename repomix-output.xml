    verification_url: `${typeof window !== "undefined" ? window.location.origin : ""}/verify-credential/${verificationCode}`,
  };

  // 1. Supabase attempt
  if (supabase) {
    try {
      await supabase.from("issued_certificates").insert([
        {
          school_id: newRecord.school_id,
